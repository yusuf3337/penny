{
  "expo": {
    "name": "Penny",
    "slug": "penny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yusufcepni.penny",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "tr",
          "en",
          "de",
          "fr",
          "ko",
          "zh-Hans",
          "ja",
          "ru",
          "it"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#240F00",
          "dark": {
            "backgroundColor": "#240F00"
          }
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "2bdfe812-8f45-4c60-89d5-ae22961bb0db"
      }
    },
    "owner": "yusuf3337"
  }
}
