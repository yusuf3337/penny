{
  "expo": {
    "name": "Penny",
    "slug": "penny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yusufcepni.penny",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Penny may need Photos access if iOS provides a backup file you selected through the photo library. Penny reads only that file and does not scan your other photos.",
        "CFBundleLocalizations": [
          "tr",
          "en",
          "de",
          "fr",
          "ko",
          "zh-Hans",
          "ja",
          "ru",
          "it"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Penny uses the microphone to let you add income and expenses by voice.",
          "speechRecognitionPermission": "Penny turns your speech into a transaction draft for you to review before saving."
        }
      ],
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F5",
          "dark": {
            "backgroundColor": "#0F1816"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2bdfe812-8f45-4c60-89d5-ae22961bb0db"
      }
    },
    "owner": "yusuf3337"
  }
}
